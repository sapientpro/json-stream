{
  "name": "@sapientpro/json-stream",
  "version": "2.0.1",
  "description": "A JSON stream parser",
  "license": "MIT",
  "author": {
    "name": "Dmyto Kulyk",
    "email": "dmytro.kulyk@sapient.pro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientpro/json-stream.git"
  },
  "bugs": {
    "url": "https://github.com/sapientpro/json-stream/issues"
  },
  "homepage": "https://github.com/sapientpro/json-stream",
  "keywords": [
    "json",
    "stream",
    "parser"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build && npm run test",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig-esm.json && node scripts/dist-type.mjs",
    "test": "jest",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs && bun scripts/benchmark.mjs && node scripts/benchmark-report.mjs",
    "benchmark:competitors": "npm run build && node --expose-gc scripts/benchmark-competitors.mjs && bun scripts/benchmark-competitors.mjs && node --expose-gc scripts/benchmark-competitors.mjs --checks && bun scripts/benchmark-competitors.mjs --checks && node scripts/benchmark-competitors-report.mjs",
    "benchmark:competitors:node": "npm run build && node --expose-gc scripts/benchmark-competitors.mjs",
    "benchmark:competitors:bun": "npm run build && bun scripts/benchmark-competitors.mjs",
    "benchmark:regression": "node --expose-gc scripts/benchmark-regression.mjs && bun scripts/benchmark-regression.mjs",
    "benchmark:node": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "benchmark:bun": "npm run build && bun scripts/benchmark.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@streamparser/json": "0.0.26",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.6",
    "jest": "^29.7.0",
    "json-stream-lite": "1.3.1",
    "json-web-streams": "1.2.0",
    "stream-json": "3.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "typesVersions": {
    "*": {
      "node": [
        "dist/cjs/node.d.ts"
      ]
    }
  }
}
